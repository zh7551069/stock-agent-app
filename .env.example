# 复制为环境变量或自行 export。不要把填好的 .env 提交进 git。
# 记账 / 归因接口不需要下面的行情路径；盘面、ETL、真跑 5min 扫描才需要。

# 公网登录，格式 user:password。本机 127.0.0.1 直连可以留空。
STOCK_ADVICE_AUTH=

# Flask session 签名。留空时首次启动写 apps/bff/.secret（已 gitignore）。
STOCK_ADVICE_SECRET=

# 行情 DuckDB（只给本机 BFF / 扫描脚本读，手机不直连）
STOCK_ADVICE_DB=

# openclaw 工作区。设置后脚本目录是 $OPENCLAW_WORKSPACE/scripts。
# 不设：若本机已有 ~/.openclaw-autoclaw/workspace/scripts 就用它，否则用仓库 scripts/liupan。
OPENCLAW_WORKSPACE=

# 直接指定 liupan_*.py 所在目录（覆盖上一行）。仓库副本是 scripts/liupan。
LIUPAN_SCRIPTS=

# Obsidian 知识库根目录（原推荐站；本切片记账不读它）
STOCK_ADVICE_VAULT=

# 每日增量包目录
STOCK_ADVICE_PACK_DIR=

# DuckDB 溢写目录与上限
DUCK_TMP=
DUCK_TMP_MAX=20GB

# 可选。默认 apps/bff/data/ 下的 sqlite 与 jsonl，都已 gitignore。
LIUPAN_SQLITE=
LIUPAN_TRACE=

# 监听地址。默认 127.0.0.1。不要为了手机直连改成把 DuckDB 暴露出去。
SAA_HOST=127.0.0.1
