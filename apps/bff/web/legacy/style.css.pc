:root{
  --bg:#f5f6f8; --card:#ffffff; --line:#e6e8ec; --text:#1c2430; --dim:#6b7684;
  --up:#c0392b; --down:#1e8449; --accent:#2c5f9e; --accent-soft:#eaf1fa;
  --warn:#b7791f; --warn-soft:#fdf6e7; --shadow:0 1px 2px rgba(16,24,40,.06),0 4px 12px rgba(16,24,40,.05);
}
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{
  background:var(--bg); color:var(--text);
  font:14px/1.55 -apple-system,BlinkMacSystemFont,"PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;
  -webkit-font-smoothing:antialiased;
}
h1,h2,h3,h4,p{margin:0}
button{font-family:inherit;cursor:pointer}

/* ── 顶栏 ── */
.topbar{
  display:flex;justify-content:space-between;align-items:center;gap:16px;
  padding:18px 28px 14px;background:linear-gradient(180deg,#fff 0%,#fbfcfe 100%);
  border-bottom:1px solid var(--line);
}
.brand{display:flex;align-items:center;gap:12px}
.logo{font-size:28px}
.brand h1{font-size:19px;letter-spacing:.2px}
.tagline{color:var(--dim);font-size:12px;margin-top:2px}
.topmeta{display:flex;align-items:center;gap:14px}
.datebox{text-align:right;font-size:12px;color:var(--dim)}
.datebox .label{display:block}
.datebox strong{font-size:15px;color:var(--text)}
.dim{color:var(--dim);font-size:12px}
.autostatus{font-size:11.5px;color:#4a5568;background:#eef7f0;border:1px solid #d5e9da;border-radius:999px;padding:5px 10px;white-space:nowrap;cursor:default}
.autostatus.warn{background:#fdf6e7;border-color:#f0dfb8;color:var(--warn)}
.autostatus.off{background:#f2f5f9;border-color:var(--line);color:var(--dim)}
.autostatus.busy{background:#e9f3fd;border-color:#c9dff4;color:#1f5f9e}
.btn{border:1px solid var(--line);background:#fff;border-radius:8px;padding:7px 13px;font-size:13px;color:var(--text)}
.btn:hover{background:#f2f5f9}
.btn.ghost{box-shadow:none}
.btn.primary{background:var(--accent);color:#fff;border-color:var(--accent)}

/* ── 导航 ── */
.tabs{display:flex;gap:6px;padding:10px 28px 0;background:#fff;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:20}
.tab{
  border:none;background:none;padding:10px 16px;font-size:14px;color:var(--dim);
  border-bottom:2px solid transparent;border-radius:6px 6px 0 0;
}
.tab:hover{color:var(--text);background:#f7f9fc}
.tab.active{color:var(--accent);border-bottom-color:var(--accent);font-weight:600}
.pill{background:#eef2f7;color:#5b6673;border-radius:10px;padding:1px 7px;font-size:11px;margin-left:4px}

main{padding:22px 28px 60px;max-width:1280px;margin:0 auto}
.page[hidden]{display:none}

/* ── 大盘环境 ── */
.env{
  display:flex;flex-wrap:wrap;gap:18px;align-items:center;
  background:var(--card);border:1px solid var(--line);border-radius:12px;
  padding:14px 18px;box-shadow:var(--shadow);margin-bottom:18px;
}
.env .gate{font-size:15px;font-weight:700;padding:6px 14px;border-radius:999px}
.env .gate.g进攻{background:#fdecea;color:var(--up)}
.env .gate.g中性{background:#eef2f7;color:#41505f}
.env .gate.g防守{background:#eaf6ee;color:var(--down)}
.env .kv{font-size:12px;color:var(--dim)}
.env .kv b{display:block;font-size:16px;color:var(--text);font-weight:600}
.env .kv .up{color:var(--up)} .env .kv .down{color:var(--down)}
.env .note{font-size:12px;color:var(--warn);background:var(--warn-soft);padding:6px 10px;border-radius:8px}
.env .secs{font-size:12px;color:var(--dim)}
.env .secs span{display:inline-block;background:#f2f5f9;border-radius:6px;padding:2px 8px;margin:2px 4px 2px 0;color:#41505f}

/* ── 时段选择 ── */
.bucketbar{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:14px}
.bucket{
  display:flex;flex-direction:column;align-items:flex-start;gap:2px;
  background:var(--card);border:1px solid var(--line);border-radius:12px;
  padding:12px 16px;text-align:left;box-shadow:var(--shadow);transition:.15s;
}
.bucket:hover{border-color:#c9d6e6;transform:translateY(-1px)}
.bucket.active{border-color:var(--accent);background:var(--accent-soft);box-shadow:0 0 0 1px var(--accent) inset}
.b-icon{font-size:18px}
.b-name{font-weight:700;font-size:15px}
.b-desc{font-size:12px;color:var(--dim)}

.bucketinfo{display:flex;justify-content:space-between;gap:16px;align-items:flex-start;margin-bottom:16px;flex-wrap:wrap}
.note{font-size:12.5px;color:#4a5568;background:#fff;border:1px solid var(--line);border-left:3px solid var(--accent);
  border-radius:8px;padding:9px 13px;max-width:640px}
.chips{display:flex;flex-wrap:wrap;gap:6px;justify-content:flex-end}
.chip{font-size:12px;background:#fff;border:1px solid var(--line);border-radius:999px;padding:4px 10px;color:#41505f}
.chip b{color:var(--accent);margin-left:4px}

/* ── 股票列表 ── */
.stocklist{display:flex;flex-direction:column;gap:10px}
.stock{
  background:var(--card);border:1px solid var(--line);border-radius:12px;
  box-shadow:var(--shadow);overflow:hidden;
}
.stock-head{display:grid;grid-template-columns:40px 1.5fr 1fr 110px 90px 1.6fr 24px;gap:12px;align-items:center;padding:13px 16px;cursor:pointer}
.rank{font-size:13px;color:var(--dim);font-weight:700}
.rank.top{color:var(--accent)}
.nm{font-weight:700;font-size:15px}
.nm small{font-weight:400;color:var(--dim);font-size:12px;margin-left:6px}
.ind{font-size:12px;color:var(--dim)}
.price{text-align:right;font-variant-numeric:tabular-nums}
.price b{font-size:15px}
.up{color:var(--up)} .down{color:var(--down)}
.scorewrap{display:flex;align-items:center;gap:8px}
.scorebar{flex:1;height:6px;background:#eef1f5;border-radius:3px;overflow:hidden}
.scorebar i{display:block;height:100%;background:linear-gradient(90deg,#4a86c8,#2c5f9e);border-radius:3px}
.scoreval{font-weight:700;font-size:13px;color:var(--accent);width:30px;text-align:right}
.hits{display:flex;flex-wrap:wrap;gap:5px}
.hit{font-size:11.5px;background:#f2f6fb;color:#33506f;border-radius:6px;padding:2px 7px;white-space:nowrap}
.hit.risk{background:#fdecea;color:var(--up)}
.caret{color:#aab4c0;font-size:12px;transition:.2s}
.stock.open .caret{transform:rotate(90deg)}
.stock-body{display:none;border-top:1px dashed var(--line);padding:14px 16px 16px;background:#fcfdff}
.stock.open .stock-body{display:block}
.detail-grid{display:grid;grid-template-columns:1.4fr 1fr;gap:20px}
.hitrow{display:flex;gap:10px;padding:7px 0;border-bottom:1px solid #f0f2f6}
.hitrow:last-child{border-bottom:none}
.hitrow .tag{flex:0 0 auto;font-size:11.5px;background:var(--accent-soft);color:var(--accent);border-radius:6px;padding:2px 8px;height:fit-content;font-weight:600}
.hitrow .why{font-size:13px}
.hitrow .trig{font-size:12px;color:var(--warn);margin-top:2px}
.spark{width:100%;height:80px}
.spark path{fill:none;stroke:var(--accent);stroke-width:1.8}
.spark .area{fill:rgba(44,95,158,.08);stroke:none}
.kvline{display:flex;justify-content:space-between;font-size:12.5px;padding:4px 0;color:var(--dim)}
.kvline b{color:var(--text);font-weight:600}

/* ── 网格 ── */
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(310px,1fr));gap:14px}
.toolbar{display:flex;align-items:center;gap:16px;margin-bottom:14px;flex-wrap:wrap}
.toolbar.wrap{flex-wrap:wrap}
.hint{font-size:12.5px;color:var(--dim)}
.seg{display:inline-flex;background:#eef1f5;border-radius:9px;padding:3px;gap:2px}
.seg button{border:none;background:none;padding:6px 13px;border-radius:7px;font-size:13px;color:#4a5568}
.seg button.on{background:#fff;color:var(--accent);font-weight:600;box-shadow:0 1px 2px rgba(0,0,0,.08)}
.search{flex:1;min-width:260px;border:1px solid var(--line);border-radius:9px;padding:9px 13px;font-size:13.5px;background:#fff}
.search:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px rgba(44,95,158,.1)}
.select{border:1px solid var(--line);border-radius:9px;padding:9px 11px;font-size:13px;background:#fff}

.s-card{
  background:var(--card);border:1px solid var(--line);border-radius:12px;padding:15px 16px;
  box-shadow:var(--shadow);cursor:pointer;transition:.15s;display:flex;flex-direction:column;gap:8px;
}
.s-card:hover{border-color:#c9d6e6;transform:translateY(-2px);box-shadow:0 6px 18px rgba(16,24,40,.09)}
.s-top{display:flex;justify-content:space-between;align-items:flex-start;gap:8px}
.s-title{font-weight:700;font-size:14.5px}
.s-bucket{font-size:11px;padding:2px 8px;border-radius:999px;white-space:nowrap;font-weight:600}
.b-盘前{background:#fdf1e6;color:#a85c14}
.b-盘中{background:#e9f3fd;color:#1f5f9e}
.b-盘后{background:#eef0fb;color:#4a4b9c}
.s-one{font-size:12.5px;color:#4a5568;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.s-meta{display:flex;justify-content:space-between;align-items:center;font-size:11.5px;color:var(--dim);margin-top:auto}
.s-meta .hits b{color:var(--accent)}

.c-card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:14px 15px;box-shadow:var(--shadow);cursor:pointer;transition:.15s;display:flex;flex-direction:column;gap:7px}
.c-card:hover{border-color:#c9d6e6;transform:translateY(-2px)}
.c-card .t{font-weight:700;font-size:14px;line-height:1.35}
.c-card .o{font-size:12.5px;color:#4a5568;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.c-tags{display:flex;flex-wrap:wrap;gap:4px}
.tg{font-size:10.5px;background:#f2f5f9;color:#5b6673;border-radius:5px;padding:1px 6px}
.tg.exec{background:#e8f5ec;color:#1e8449;font-weight:600}

.check{display:inline-flex;align-items:center;gap:6px;font-size:13px;color:#4a5568;background:#fff;border:1px solid var(--line);border-radius:9px;padding:8px 12px;cursor:pointer}
.check input{accent-color:var(--accent)}
.pager{display:flex;justify-content:center;align-items:center;gap:14px;margin-top:20px}

/* ── Markdown ── */
.md{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:26px 30px;box-shadow:var(--shadow);font-size:14px;line-height:1.75}
.md h1{font-size:22px;margin:6px 0 14px}
.md h2{font-size:17px;margin:22px 0 10px;padding-bottom:6px;border-bottom:1px solid var(--line)}
.md h3{font-size:15px;margin:16px 0 8px}
.md p{margin:8px 0}
.md ul,.md ol{margin:8px 0 8px 22px;padding:0}
.md li{margin:4px 0}
.md code{background:#f2f5f9;border-radius:4px;padding:1px 5px;font-size:12.5px;font-family:ui-monospace,Menlo,monospace}
.md table{border-collapse:collapse;margin:12px 0;font-size:13px;width:100%}
.md th,.md td{border:1px solid var(--line);padding:6px 10px;text-align:left}
.md th{background:#f7f9fc;font-weight:600}
.md blockquote{border-left:3px solid var(--accent);background:#f7faff;margin:10px 0;padding:8px 14px;color:#41505f;border-radius:0 8px 8px 0}
.md hr{border:none;border-top:1px solid var(--line);margin:18px 0}
.md a{color:var(--accent);text-decoration:none}
.md a:hover{text-decoration:underline}

/* ── 弹窗 ── */
.modal{position:fixed;inset:0;background:rgba(16,24,40,.45);display:flex;align-items:flex-start;justify-content:center;padding:40px 20px;z-index:100;overflow:auto}
.modal[hidden]{display:none}
.modal-card{background:#fff;border-radius:14px;max-width:820px;width:100%;padding:26px 30px 30px;position:relative;box-shadow:0 20px 50px rgba(16,24,40,.25)}
.modal-close{position:absolute;top:14px;right:16px;border:none;background:#f2f5f9;border-radius:8px;width:30px;height:30px;font-size:14px;color:#5b6673}
.modal-close:hover{background:#e6e8ec}

.kv-table{display:grid;grid-template-columns:110px 1fr;gap:6px 12px;font-size:13px;margin:12px 0}
.kv-table .k{color:var(--dim)}
.param{display:inline-block;background:#f2f6fb;color:#33506f;border-radius:6px;padding:2px 8px;margin:2px 4px 2px 0;font-size:12px;font-family:ui-monospace,Menlo,monospace}
.triggerbox{background:var(--warn-soft);border-left:3px solid var(--warn);border-radius:0 8px 8px 0;padding:8px 12px;font-size:12.5px;color:#7a5613;margin-top:6px}

@media (max-width:900px){
  .stock-head{grid-template-columns:30px 1.4fr 80px 80px 1fr 18px}
  .stock-head .ind{display:none}
  .detail-grid{grid-template-columns:1fr}
  .bucketbar{grid-template-columns:1fr}
  main{padding:16px 14px 40px}
  .topbar{padding:14px 16px}
}
